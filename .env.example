# Financial Operating System Environment Variables
# Copy this file to .env and fill in the required values
# DO NOT commit .env to the repository (it's gitignored)

# REQUIRED: Database Connection
# Get this from: TiDB Cloud Dashboard → ConstructionEnterprisesFOS cluster → Connect dialog
# Format: mysql://username:password@host:4000/fos_db?ssl={"rejectUnauthorized":true}
DATABASE_URL=mysql://username:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/fos_db?ssl={"rejectUnauthorized":true}

# OPTIONAL: Server Configuration
NODE_ENV=development
PORT=3000

# OPTIONAL: Session Security (defaults to "development-secret" for local dev)
COOKIE_SECRET=your-secret-key-here

# OPTIONAL: Built-in Forge API Integration (not required for basic local dev)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# OPTIONAL: Gmail OAuth Integration (required only for Gmail features)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
PUBLIC_APP_URL=http://localhost:3000

# VCSD sandbox pilot: leave sandbox-only sending enabled.
OUTREACH_SANDBOX_ONLY=true
SHARED_INBOX=chappellintl@gmail.com

# Optional scheduled follow-ups. Leave blank to disable the endpoint.
# Set to a random secret of at least 32 characters only after follow-up review.
SCHEDULED_JOB_SECRET=
